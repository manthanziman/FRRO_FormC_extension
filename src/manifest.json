{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "FRRO Form C Helper",
  "description": "Fills FRRO Form C using booking and guest data from your platform.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Open Side Panel"
  },
  "side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "FRRO Form C"
  },
  "permissions": ["sidePanel", "storage", "cookies", "idle"],
  "host_permissions": [
    "$EXTENSION_PUBLIC_API_ORIGIN/*",
    "$EXTENSION_PUBLIC_GO_ORIGIN/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://indianfrro.gov.in/*",
        "https://www.indianfrro.gov.in/*",
        "http://localhost/*",
        "file:///C:/Users/Chetan/Downloads/hosteller-frro-extension/index.html"
      ],
      "js": ["content/scripts.jsx"]
    }
  ]
}